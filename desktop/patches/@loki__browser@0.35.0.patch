-
+const awaitLokiReady = async (window, options = {}) => {
+  const id = new URL(window.location.href).searchParams.get('id');
+  const timeout = options.studioTimeoutMs || 60000;
+  const started = window.performance.now();
+  const delay = ms => new Promise(resolve => window.setTimeout(resolve, ms));
+  const check = () => {
+    if (window.__STUDIO_STORY_ERROR__) throw new Error(window.__STUDIO_STORY_ERROR__);
+    const phase = window.__STORYBOOK_PREVIEW__?.currentRender?.phase;
+    if (phase === 'errored' || window.document.querySelector('.sb-show-errordisplay, .sb-show-nopreview'))
+      throw new Error(`Story ${id} failed to render`);
+    if (options.studioErrorSelector && window.document.querySelector(options.studioErrorSelector))
+      throw new Error(`Story ${id}: error selector found: ${options.studioErrorSelector}`);
+    if (window.performance.now() - started > timeout)
+      throw new Error(`Story ${id} did not finish rendering within ${timeout}ms. Check loaders/play and the supported Storybook version.`);
+  };
+  if (id) {
+    // Wait for render, loaders and play, independently of the framework used by the story.
+    while (window.__STORYBOOK_PREVIEW__?.currentRender?.phase !== 'finished') {
+      check();
+      await delay(25);
+    }
+    check();
+    if (options.studioReadySelector) {
+      while (!window.document.querySelector(options.studioReadySelector)) { check(); await delay(25); }
+    }
+    await window.document.fonts.ready;
+    await Promise.all(Array.from(window.document.images).map(async image => {
+      try {
+        if (!image.complete) await image.decode();
+        if (image.currentSrc && !image.naturalWidth) throw new Error(`Broken image: ${image.currentSrc}`);
+      } catch (error) { if (options.studioFailOnBrokenImages !== false) throw error; }
+    }));
+  }
+  const settle = options.studioSettleMs ?? 350;
+  await delay(Math.max(0, settle - Math.min(100, settle)));
+  if (window.loki?.awaitReady) await window.loki.awaitReady();
+  await delay(Math.min(100, settle));
+  if (window.loki?.awaitReady) await window.loki.awaitReady();
+  if (id) check();
+};
 module.exports = awaitLokiReady;
