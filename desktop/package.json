{
  "name": "storybook-studio",
  "version": "1.1.0",
  "private": true,
  "description": "Desktop Storybook visual regression review",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui.cjs",
    "package": "node scripts/package.cjs",
    "fixtures:build": "node scripts/build-fixtures.cjs",
    "test:integration": "node tests/integration.cjs"
  },
  "dependencies": {
    "@loki/target-chrome-docker": "0.35.0",
    "@loki/browser": "0.35.0",
    "@loki/target-chrome-core": "0.35.0",
    "@loki/diff-pixelmatch": "0.35.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "@electron/packager": "20.3.0",
    "playwright": "1.58.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "@loki/browser@0.35.0": "patches/@loki__browser@0.35.0.patch",
      "@loki/target-chrome-core@0.35.0": "patches/@loki__target-chrome-core@0.35.0.patch",
      "@loki/target-chrome-docker@0.35.0": "patches/@loki__target-chrome-docker@0.35.0.patch"
    }
  },
  "packageManager": "pnpm@9.15.9",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
